# Neon (Serverless Postgres) bağlantı dizesi
# Netlify Database deploy sırasında NETLIFY_DB_URL otomatik gelir.
# Yerelde netlify dev kullan veya kendi Postgres adresini yaz:
DATABASE_URL="postgresql://user:pass@host/masam?sslmode=require"

# Better Auth (Aşama 2)
BETTER_AUTH_SECRET="openssl rand -base64 32 ile üret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Aşama 2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Ödeme webhook (Aşama 7) — Lemon Squeezy veya Polar
PAYMENT_WEBHOOK_SECRET=""

# Ödeme (Aşama 7)
NEXT_PUBLIC_CHECKOUT_URL=""
